{
  "name": "crimon",
  "version": "0.1.0",
  "private": true,
  "description": "モンスター4対4のターン制コマンドバトルゲーム",
  "type": "module",
  "scripts": {
    "battle": "tsx src/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "harness": "node tools/harness.mjs",
    "tour": "node tools/tour.mjs",
    "audio:check": "node tools/audioCheck.mjs",
    "audio:render": "tools/audio/.venv/bin/python tools/audio/render.py",
    "audio:bgm": "tools/audio/.venv/bin/python tools/audio/render_bgm.py",
    "monster": "tsx tools/monsterDoctor.mts",
    "balance": "tsx tools/dungeonProbe.ts",
    "check": "npm run typecheck && npm run test && npm run tour"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  }
}
